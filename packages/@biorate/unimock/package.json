{
  "name": "@biorate/unimock",
  "version": "1.17.0",
  "description": "Snapshot-based proxy mocking for connectors and services",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    },
    "./vitest/setup": {
      "types": "./dist/types/src/vitest/setup.d.ts",
      "import": "./dist/esm/src/vitest/setup.js",
      "require": "./dist/cjs/src/vitest/setup.js",
      "default": "./dist/cjs/src/vitest/setup.js"
    },
    "./vitest": {
      "types": "./dist/types/src/vitest/index.d.ts",
      "import": "./dist/esm/src/vitest/index.js",
      "require": "./dist/cjs/src/vitest/index.js",
      "default": "./dist/cjs/src/vitest/index.js"
    }
  },
  "files": [
    "dist/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "cleanup dist",
    "build:cjs": "npx tsc -p ./tsconfig.build.cjs.json",
    "build:esm": "npx tsc -p ./tsconfig.build.esm.json",
    "build:types": "npx tsc -p ./tsconfig.build.types.json",
    "build": "pnpm run clean && pnpm run build:cjs && pnpm run build:esm && pnpm run build:types",
    "postbuild:cjs": "node ../../../.scripts/write-package-type.js dist/cjs commonjs",
    "postbuild:esm": "tsc-esm-fix --tsconfig=./tsconfig.build.esm.json --target=./dist/esm && node ../../../.scripts/write-package-type.js dist/esm module",
    "format": "prettier --check src",
    "lint": "eslint src --ext .ts",
    "format:fix": "prettier --write src",
    "lint:fix": "eslint src --ext .ts --fix",
    "test": "pnpm run test:replay",
    "test:unit": "npx vitest run --coverage tests/unit",
    "test:e2e": "UNIMOCK_STRIP_REQUEST=1 UNIMOCK_SKIP_CONN_ARGS=1 UNIMOCK_GZIP=1 UNIMOCK=record npx vitest run --coverage tests/e2e",
    "test:replay": "UNIMOCK=replay npx vitest run --coverage",
    "test:record": "UNIMOCK_STRIP_REQUEST=1 UNIMOCK_SKIP_CONN_ARGS=1 UNIMOCK_GZIP=1 UNIMOCK=record npx vitest run --coverage",
    "prepublishOnly": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/biorate/core.git",
    "directory": "packages/@biorate/unimock"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://biorate.github.io/core",
  "keywords": [
    "mock",
    "snapshot",
    "e2e",
    "connector"
  ],
  "author": "llevkin",
  "license": "MIT",
  "devDependencies": {
    "@biorate/clickhouse": "^2.4.5",
    "@biorate/config": "^3.2.5",
    "@biorate/ioredis": "^2.3.2",
    "@biorate/mongodb": "^2.1.5",
    "@biorate/mssql": "^2.1.5",
    "@biorate/opensearch": "^2.1.5",
    "@biorate/pg": "^2.1.5",
    "@biorate/prometheus": "^3.1.5",
    "@biorate/proxy": "^2.2.2",
    "@biorate/proxy-prometheus": "^2.1.10",
    "@biorate/rdkafka": "^2.3.5",
    "@biorate/redis": "^2.1.5",
    "@biorate/schema-registry": "^3.1.16",
    "@biorate/tools": "^3.1.4",
    "@confluentinc/kafka-javascript": "latest",
    "@types/lodash-es": "^4.17.12"
  },
  "peerDependencies": {
    "lodash-es": ">=4.18.1"
  },
  "dependencies": {
    "@biorate/errors": "^3.1.3",
    "@biorate/inversion": "^3.1.5",
    "@biorate/lifecycled": "^3.2.5",
    "@biorate/sequelize": "^2.3.3"
  },
  "gitHead": "58e33c5c146be2ade7957d96f1bc61eb801217e2"
}
